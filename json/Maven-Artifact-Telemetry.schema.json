{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example.com/schemas/maven-artifact-telemetry.schema.json",
 "title": "MavenArtifactTelemetry",
 "description": "Schema for individual cached Maven artifact telemetry payloads scraped and extracted via Playwright and HTTP sources.",
 "type": "object",
 "required": [
   "coordinate",
   "http_sources",
   "playwright_sources"
 ],
 "properties": {
   "coordinate": {
     "type": "object",
     "description": "Artifact Maven coordinates and BOM association.",
     "required": [
       "groupId",
       "artifactId",
       "bomVersion",
       "version"
     ],
     "properties": {
       "groupId": {
         "type": "string",
         "description": "The Maven groupId (e.g., com.fasterxml.jackson.core)."
       },
       "artifactId": {
         "type": "string",
         "description": "The Maven artifactId (e.g., jackson-core)."
       },
       "bomVersion": {
         "type": "string",
         "description": "The target or aligned BOM version (e.g., 2.21.4 or 12.0.36)."
       },
       "version": {
         "type": "string",
         "description": "The specific pinned version. Empty string indicates that the artifact version is managed directly by the BOM."
       }
     },
     "additionalProperties": false
   },
   "http_sources": {
     "type": "object",
     "description": "Telemetry collected from direct HTTP/REST APIs via headless browser in-page fetch.",
     "required": [
       "deps_dev",
       "search_maven_org",
       "repo1_maven_org",
       "osv_dev"
     ],
     "properties": {
       "deps_dev": {
         "type": "object",
         "description": "Data retrieved from Google Open Source Insights (deps.dev).",
         "required": [
           "dependentCount",
           "starsCount",
           "forksCount",
           "scorecard"
         ],
         "properties": {
           "dependentCount": {
             "type": "integer",
             "minimum": 0,
             "description": "Downstream dependent packages known to depend on this artifact."
           },
           "starsCount": {
             "type": "integer",
             "minimum": 0,
             "description": "GitHub/upstream repository stars."
           },
           "forksCount": {
             "type": "integer",
             "minimum": 0,
             "description": "GitHub/upstream repository forks."
           },
           "scorecard": {
             "description": "OpenSSF Scorecard evaluation payload, or null if repository is unscanned.",
             "oneOf": [
               {
                 "type": "null"
               },
               {
                 "type": "object",
                 "required": [
                   "overallScore",
                   "date",
                   "checks"
                 ],
                 "properties": {
                   "overallScore": {
                     "type": "number",
                     "minimum": 0.0,
                     "maximum": 10.0,
                     "description": "Overall OpenSSF hygiene score."
                   },
                   "date": {
                     "type": "string",
                     "format": "date-time",
                     "description": "ISO-8601 timestamp of when the OpenSSF scan was executed."
                   },
                   "checks": {
                     "type": "array",
                     "description": "List of individual OpenSSF hygiene checks.",
                     "items": {
                       "type": "object",
                       "required": [
                         "name",
                         "score",
                         "reason"
                       ],
                       "properties": {
                         "name": {
                           "type": "string",
                           "description": "Check identifier (e.g., Maintained, Code-Review, Vulnerabilities)."
                         },
                         "score": {
                           "type": "integer",
                           "minimum": -1,
                           "maximum": 10,
                           "description": "Check score (-1 represents inconclusive or disabled)."
                         },
                         "reason": {
                           "type": "string",
                           "description": "Explanation of check findings."
                         }
                       },
                       "additionalProperties": false
                     }
                   }
                 },
                 "additionalProperties": false
               }
             ]
           }
         },
         "additionalProperties": false
       },
       "search_maven_org": {
         "type": "object",
         "description": "Data retrieved from Maven Central Solr Search API.",
         "required": [
           "versionCount",
           "timestamp",
           "latestVersion",
           "ec"
         ],
         "properties": {
           "versionCount": {
             "type": "integer",
             "minimum": 0,
             "description": "Total number of releases published under this coordinate."
           },
           "timestamp": {
             "type": "integer",
             "description": "Epoch millisecond publication timestamp of the release."
           },
           "latestVersion": {
             "type": "string",
             "description": "Highest/latest published version string in Maven Central."
           },
           "ec": {
             "type": "array",
             "description": "Extension classifiers available for packaging assessment (.jar, -sources.jar, -javadoc.jar, .pom).",
             "items": {
               "type": "string"
             }
           }
         },
         "additionalProperties": false
       },
       "repo1_maven_org": {
         "type": "object",
         "description": "Authoritative metadata parsed from repo1.maven.org maven-metadata.xml.",
         "required": [
           "lastUpdated",
           "release",
           "latest"
         ],
         "properties": {
           "lastUpdated": {
             "type": "string",
             "pattern": "^[0-9]{14}$",
             "description": "Timestamp in YYYYMMDDHHMMSS format."
           },
           "release": {
             "type": "string",
             "description": "Current release version declared in maven-metadata.xml."
           },
           "latest": {
             "type": "string",
             "description": "Current latest version declared in maven-metadata.xml."
           }
         },
         "additionalProperties": false
       },
       "osv_dev": {
         "type": "object",
         "description": "Advisories retrieved from OSV.dev for the target coordinate.",
         "required": [
           "vulns"
         ],
         "properties": {
           "vulns": {
             "type": "array",
             "description": "Active CVE/GHSA advisories matching the artifact.",
             "items": {
               "type": "object",
               "required": [
                 "id"
               ],
               "properties": {
                 "id": {
                   "type": "string",
                   "description": "Advisory ID (e.g., GHSA-..., CVE-...)."
                 },
                 "summary": {
                   "type": "string",
                   "description": "Brief description of the vulnerability."
                 },
                 "aliases": {
                   "type": "array",
                   "description": "Cross-referenced CVE/GHSA IDs.",
                   "items": {
                     "type": "string"
                   }
                 },
                 "database_specific": {
                   "type": "object",
                   "properties": {
                     "severity": {
                       "type": "string",
                       "enum": [
                         "LOW",
                         "MEDIUM",
                         "HIGH",
                         "CRITICAL"
                       ],
                       "description": "Normalized advisory severity level."
                     }
                   },
                   "additionalProperties": true
                 }
               },
               "additionalProperties": true
             }
           }
         },
         "additionalProperties": false
       }
     },
     "additionalProperties": false
   },
   "playwright_sources": {
     "type": "object",
     "description": "Telemetry parsed from rendered DOM views in Playwright.",
     "required": [
       "central_sonatype_com",
       "libraries_io"
     ],
     "properties": {
       "central_sonatype_com": {
         "type": "object",
         "description": "Dependents metrics from central.sonatype.com.",
         "required": [
           "directDependentsCount",
           "transitiveDependentsCount"
         ],
         "properties": {
           "directDependentsCount": {
             "type": "integer",
             "minimum": 0,
             "description": "Direct consumer package count."
           },
           "transitiveDependentsCount": {
             "type": "integer",
             "minimum": 0,
             "description": "Transitive consumer package count."
           }
         },
         "additionalProperties": false
       },
       "libraries_io": {
         "type": "object",
         "description": "Telemetry scraped from libraries.io.",
         "required": [
           "dependentRepositoriesCount",
           "dependentPackagesCount",
           "sourceRank"
         ],
         "properties": {
           "dependentRepositoriesCount": {
             "type": "integer",
             "minimum": 0,
             "description": "Number of public GitHub/GitLab repositories importing this library."
           },
           "dependentPackagesCount": {
             "type": "integer",
             "minimum": 0,
             "description": "Number of published packages that depend on this library."
           },
           "sourceRank": {
             "type": "integer",
             "minimum": 0,
             "description": "Libraries.io quality heuristic rank (typically 0-30)."
           }
         },
         "additionalProperties": false
       }
     },
     "additionalProperties": false
   }
 },
 "additionalProperties": false
}
